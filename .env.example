# Copy to `.env` next to docker-compose.yml and fill in whichever keys you have.
#
#   cp .env.example .env
#
# `.env` is gitignored. Every key is optional: with none of them the router
# falls back to Ollama on the host, and each one you add widens what it can
# route to. Compose reads this file for both variable substitution below and
# the environment handed to the container.
#
# One account per provider. Their terms allow programmatic use of a free tier
# and forbid multiplying limits across accounts; this file has one slot each.

# -- provider credentials ----------------------------------------------------

# Fastest free inference. 30 req/min, 14,400/day. No card required.
# https://console.groq.com/keys
GROQ_API_KEY=

# Largest free daily allowance and a very long context window.
# 15 req/min, 1,500/day. No card required.
# NOTE: free-tier prompts may be used for model training.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Very fast, limits comparable to Groq. No card required.
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# A normal GitHub personal access token; no special scopes needed.
# 15 req/min, 150/day, with a hard 8k input / 4k output ceiling per request.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -- reaching the router -----------------------------------------------------

# Key the router demands from callers, in `Authorization: Bearer <key>`.
#
# Empty means no authentication, which is fine while nothing but this machine
# can reach the port. Compose publishes 4141 on every host interface, so the
# moment another machine is on the network — Home Assistant, say — anyone who
# can reach it can spend your quota. Generate one with:
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#
# `/health` stays open either way, so the container healthcheck keeps working.
ONFEATHER_API_KEY=

# -- compose settings --------------------------------------------------------

# Image to pull. Override to use a fork or a local build.
ONFEATHER_IMAGE=ghcr.io/rickyleroi/onfeather
# `latest` tracks main; pin a release tag (e.g. v0.0.1) for something stable.
ONFEATHER_TAG=latest
# Set to `always` to re-pull on every `up`.
ONFEATHER_PULL_POLICY=missing

# Host port the router listens on.
ONFEATHER_PORT=4141
# balanced | fast | local
ONFEATHER_STRATEGY=balanced

# Host directory with your .gguf files, mounted read-only at /models.
ONFEATHER_MODELS_DIR=./models
