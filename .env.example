# 20260803 ++ RG #Docker Copy to `.env`. Every key is optional; with none, the router falls back to Ollama.
# 20260803 ++ RG #Docker One account per provider: their terms forbid multiplying limits across accounts.

# -- provider credentials ----------------------------------------------------

# 20260725 RG Fastest free inference. 30 req/min, 14,400/day. https://console.groq.com/keys
GROQ_API_KEY=

# 20260725 RG Largest daily allowance, longest context. Free-tier prompts may train the model.
# 20260725 RG https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 20260725 RG Very fast, limits comparable to Groq. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 20260725 RG A plain PAT, no scopes. 15 req/min, 150/day, 8k in / 4k out per request.
GITHUB_TOKEN=

# 20260725 RG https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# 20260725 RG https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -- reaching the router -----------------------------------------------------

# 20260804 ++ RG #HASS Key the router demands, in `Authorization: Bearer`.
# 20260808 ** RG #Security Required: compose publishes 4141 on every interface, and off
# 20260808 ** RG #Security loopback `of-free serve` refuses to start without a key. Generate one:
# 20260808 ** RG #Security   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
ONFEATHER_API_KEY=

# -- compose settings --------------------------------------------------------

# 20260803 ++ RG #Docker Override to use a fork or a local build.
ONFEATHER_IMAGE=ghcr.io/rickyleroi/onfeather
# 20260803 ++ RG #Docker `latest` tracks main; pin a release tag for something stable.
ONFEATHER_TAG=latest
# 20260803 ++ RG #Docker Set to `always` to re-pull on every `up`.
ONFEATHER_PULL_POLICY=missing

ONFEATHER_PORT=4141
# 20260803 ++ RG #Docker balanced | fast | local
ONFEATHER_STRATEGY=balanced

# 20260803 ++ RG #Docker Host directory with your .gguf files, mounted read-only at /models.
ONFEATHER_MODELS_DIR=./models
